                src="/Bricks_Project/Images/legacy-history.svg"
                alt="Factory Foundry Floor"
                class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
              />
            </div>
            <!-- <div
              class="absolute -bottom-8 -right-8 bg-slate-900 text-white p-8 rounded-2xl shadow-2xl hidden sm:block border border-slate-800 max-w-xs"
            >
              <div
                class="text-amberGold-400 text-3xl font-serif font-bold mb-1"

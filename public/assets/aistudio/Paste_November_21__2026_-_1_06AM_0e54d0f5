      // Display Sub-Product Tiles Dynamically with Images
      function displaySubTiles(categoryKey) {
        const container = document.getElementById("sub-tile-container");
        const titleEl = document.getElementById("sub-tile-title");
        const gridEl = document.getElementById("sub-tile-grid");

        const data = subProductsData[categoryKey];
        if (!data) return;

        titleEl.textContent = data.title;
        gridEl.innerHTML = "";

        data.items.forEach((itemObj) => {
          const tile = document.createElement("div");
          tile.className =
            "bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-200 flex flex-col justify-between";
          tile.innerHTML = `
            <div>
              <div class="h-32 overflow-hidden bg-slate-200">
                <img src="${itemObj.img}" alt="${itemObj.name}" class="w-full h-full object-cover">
              </div>
              <div class="p-4">
                <span class="text-[9px] font-bold uppercase tracking-wider text-terracotta-600 block mb-1">Sub-Product</span>
                <h5 class="text-xs font-bold text-slate-900 mb-2">${itemObj.name}</h5>
              </div>
            </div>
            <div class="p-4 pt-0">
              <a href="#contact" onclick="selectProductInForm('${itemObj.name}')" class="w-full py-2 px-3 bg-terracotta-50 text-terracotta-700 rounded-xl text-xs font-semibold hover:bg-terracotta-600 hover:text-white transition-colors flex items-center justify-center gap-1">
                Request Quote <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </div>
          `;
          gridEl.appendChild(tile);
        });

        container.classList.remove("hidden");
        container.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      function closeSubTiles() {
        document.getElementById("sub-tile-container").classList.add("hidden");
      }

      function selectProductInForm(productName) {
        const selectEl = document.getElementById("form-product");
        if (selectEl) {
          for (let option of selectEl.options) {
            if (
              option.value === productName ||
              option.text.includes(productName)
            ) {
              selectEl.value = option.value;
              break;
            }
          }
        }
      }

      // Handle Main Contact Form Submission (Sends to Google Sheet & Email to prateekbhagat2016@gmail.com)
      function handleFormSubmit(e) {
        e.preventDefault();

        const submitBtn = e.target.querySelector('button[type="submit"]');
        submitBtn.textContent = "Submitting...";
        submitBtn.disabled = true;

        const formData = {
          name: document.getElementById("form-name").value,
          phone: document.getElementById("form-phone").value,
          email: document.getElementById("form-email").value,
          quantity:
            document.getElementById("form-qty").value || "Not specified",
          product: document.getElementById("form-product").value,
          message: document.getElementById("form-message").value || "N/A",
        };

        fetch(GOOGLE_SCRIPT_URL, {
          method: "POST",
          mode: "no-cors",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(formData),
        })
          .then(() => {
            alert(
              "Thank you! Your official inquiry has been sent to our plant team, logged in our records, and emailed to prateekbhagat2016@gmail.com.",
            );
            document.getElementById("inquiry-form").reset();
            submitBtn.textContent = "Submit Official Quote Request";
            submitBtn.disabled = false;
          })
          .catch((error) => {
            console.error("Error:", error);
            alert("Something went wrong. Please try again.");
            submitBtn.textContent = "Submit Official Quote Request";
            submitBtn.disabled = false;
          });
      }
    </script>

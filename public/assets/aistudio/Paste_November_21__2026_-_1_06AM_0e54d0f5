              </div>
              <p class="text-xs text-slate-400 mt-2">
                From fireclay mining in 1960 to advanced forging today.
              </p>
            </div> -->
          </div>
          <div class="lg:col-span-6 space-y-6">
            <div
              class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-terracotta-50 text-terracotta-700 text-xs font-bold tracking-wider uppercase border border-terracotta-200"
